---
import Layout from "../../layouts/Default.astro";
import { PortableText } from "@portabletext/astro";

const blocks = [
  {
    _type: "block",
    style: "h1",
    children: [
      {
        _type: "span",
        text: "I'm a heading",
      },
    ],
  },
  {
    _type: "block",
    style: "normal",
    children: [
      {
        _type: "span",
        text: "I'm a paragraph",
      },
    ],
  },
];
---

<Layout>
  <PortableText value={blocks}>
    <fragment slot="block:h1">
      {
        ({ Component, props, children }) => (
          <Component {...props} data-slot="block-h1">
            {children}
          </Component>
        )
      }
    </fragment>
  </PortableText>
</Layout>

---
import type { Block, Props as $ } from "@portabletext/astro/types";
import { usePortableText } from "@portabletext/astro";

export type Props = $<Block>;

const props = Astro.props;
const { getDefaultComponent } = usePortableText(props.node);
const Default = getDefaultComponent();
---

<div data-block-index={props.index}>
  <Default {...props}>
    <slot />
  </Default>
</div>

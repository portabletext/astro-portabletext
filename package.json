{
  "name": "@portabletext/astro",
  "version": "0.1.0",
  "description": "Render Portable Text with Astro",
  "keywords": [
    "astro",
    "astro-component",
    "portable-text",
    "sanity",
    "withastro"
  ],
  "homepage": "https://github.com/portabletext/astro-portabletext#readme",
  "bugs": {
    "url": "https://github.com/portabletext/astro-portabletext/issues"
  },
  "license": "ISC",
  "author": "Sanity.io <hello@sanity.io>",
  "contributors": [
    "Tom Theisel <tom.theisel@gmail.com> (original author of astro-portabletext)"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/portabletext/astro-portabletext.git"
  },
  "files": [
    "CHANGELOG.md",
    "components",
    "lib"
  ],
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "lib/*"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.ts",
    "./components": "./lib/components.ts",
    "./types": "./lib/types.ts",
    "./utils": {
      "types": "./lib/utils.d.ts",
      "import": "./lib/utils.ts",
      "default": "./lib/utils.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild:demo": "pnpm clean",
    "build:demo": "astro build --root demo",
    "clean": "rimraf demo/dist test/dist",
    "dev": "astro dev --root demo",
    "format": "oxfmt .",
    "lint": "oxlint",
    "release": "changeset publish",
    "start": "pnpm dev",
    "test": "vitest",
    "type-check": "astro check"
  },
  "dependencies": {
    "@portabletext/toolkit": "^6.0.0",
    "@portabletext/types": "^4.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.2.0",
    "astro": "^7.2.1",
    "cheerio": "^1.2.0",
    "leaflet": "^1.9.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^5.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "astro": ">=4.6.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}

---
import type {Props as $} from '@portabletext/astro/types'

import type {AnnotatedMapBlock} from '../types'

type Props = $<AnnotatedMapBlock>

const {node} = Astro.props
const config = {
  center: node.center ?? {_type: 'geopoint', lat: 51.505, lng: -0.09},
  markers: node.markers ?? [],
}
---

<div class="annotated-map" data-map={JSON.stringify(config)}>
  <div class="annotated-map-loading">Loading map…</div>
</div>

<script>
  import L from 'leaflet'
  // oxlint-disable-next-line no-unassigned-import
  import 'leaflet/dist/leaflet.css'

  interface Geopoint {
    lat: number
    lng: number
  }
  interface MapMarker {
    _key: string
    position: Geopoint
    title: string
  }
  interface MapConfig {
    center: Geopoint
    markers: MapMarker[]
  }

  // Marker images are served from a CDN to avoid asset-bundling in this demo.
  const iconBase = 'https://unpkg.com/leaflet@1.9.4/dist/images/'
  L.Icon.Default.mergeOptions({
    iconUrl: `${iconBase}marker-icon.png`,
    iconRetinaUrl: `${iconBase}marker-icon-2x.png`,
    shadowUrl: `${iconBase}marker-shadow.png`,
  })

  for (const el of document.querySelectorAll<HTMLElement>('.annotated-map')) {
    const raw = el.dataset.map
    if (!raw) continue

    const config = JSON.parse(raw) as MapConfig
    el.textContent = ''

    const map = L.map(el).setView([config.center.lat, config.center.lng], 12)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map)

    for (const marker of config.markers) {
      L.marker([marker.position.lat, marker.position.lng]).addTo(map).bindPopup(marker.title)
    }
  }
</script>

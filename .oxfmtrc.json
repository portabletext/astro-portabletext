{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": false,
  "experimentalSortImports": {},
  "ignorePatterns": ["demo/dist/**", "test/dist/**", "pnpm-lock.yaml"],
  "overrides": [
    {
      "files": [".changeset/*.md"],
      "options": {"singleQuote": false}
    }
  ]
}
